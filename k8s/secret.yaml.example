# Example Kubernetes Secret for GCP Service Account
# 
# To create the secret:
# 1. Base64 encode your service account JSON:
#    cat gcs-service-account.json | base64 -w 0
#
# 2. Replace <BASE64_ENCODED_JSON> below with the output
#
# 3. Apply: kubectl apply -f k8s/secret.yaml
#
# IMPORTANT: Never commit the actual secret.yaml file to git!
# This is a template - create your own secret.yaml from this example.

apiVersion: v1
kind: Secret
metadata:
  name: gcp-service-account
  namespace: default
type: Opaque
data:
  # Base64 encoded service account JSON
  credentials.json: <BASE64_ENCODED_JSON>
